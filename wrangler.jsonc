{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "shamsak-gowak-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-13",

  "keep_vars": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shamsak-gowak-db",
      "database_id": "a848f97f-af7c-4c4a-b162-4155670d210c"
    }
  ]
}